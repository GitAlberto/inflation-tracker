{
  "__inputs": [],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Dashboard C11 — Monitoring API modèle Prophet IPC France — inflation-tracker",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Disponibilité API modèle",
      "description": "1 = API opérationnelle (up Prometheus), 0 = inaccessible",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red"   },
                "1": { "text": "UP",   "color": "green" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"inflation_model_api\"}",
          "legendFormat": "Statut",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Statut API — req/s (200)",
      "description": "Taux de requêtes HTTP 200 reçues par l'API modèle sur 1 minute",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 0.001 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(inflation_api_requests_total{status_code=\"200\"}[1m]))",
          "legendFormat": "Req/s (200)",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Prédictions générées (total cumulé)",
      "description": "Nombre cumulé de prédictions Prophet servies depuis le démarrage du container",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(inflation_predictions_total)",
          "legendFormat": "Total prédictions",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Catégories les plus demandées",
      "description": "Classement des catégories IPC par nombre total de prédictions générées depuis le démarrage",
      "type": "bargauge",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.categorie}",
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort_desc(sum by (categorie) (inflation_predictions_total))",
          "legendFormat": "{{categorie}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Latence prédiction P95 (s)",
      "description": "95e percentile de la latence des endpoints /predict sur 5 minutes",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 30,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5    },
              { "color": "red",    "value": 10   }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(inflation_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 latence",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Taux d'erreurs API (%)",
      "description": "Pourcentage de requêtes en erreur (4xx + 5xx) sur 5 minutes",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 2    },
              { "color": "red",    "value": 5    }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(inflation_api_errors_total[5m])) / (sum(rate(inflation_api_requests_total[5m])) + 0.001)",
          "legendFormat": "Taux erreurs %",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Latence prédiction — P50 / P95 / P99",
      "description": "Évolution des percentiles de latence des requêtes /predict sur 5 minutes",
      "type": "timeseries",
      "gridPos": { "h": 13, "w": 12, "x": 0, "y": 5 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, rate(inflation_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(inflation_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(inflation_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ]
    },

    {
      "id": 8,
      "title": "Prédictions par catégorie (taux/min)",
      "description": "Débit de prédictions par catégorie IPC sur 5 minutes",
      "type": "timeseries",
      "gridPos": { "h": 13, "w": 12, "x": 12, "y": 5 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(inflation_predictions_total[5m])",
          "legendFormat": "{{categorie}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "MAE par catégorie IPC (évaluation 2025)",
      "description": "Erreur absolue moyenne du modèle Prophet par catégorie — alerte si > 5 pts IPC",
      "type": "bargauge",
      "gridPos": { "h": 13, "w": 12, "x": 0, "y": 18 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.categorie}",
          "unit": "short",
          "decimals": 3,
          "min": 0,
          "max": 6,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "orange", "value": 2    },
              { "color": "red",    "value": 5    }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "inflation_prediction_mae",
          "legendFormat": "{{categorie}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Trafic par endpoint (req/s)",
      "description": "Débit de requêtes par route API sur 5 minutes — identifie les endpoints les plus sollicités",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (endpoint) (rate(inflation_api_requests_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 11,
      "title": "Erreurs API par type",
      "description": "Débit d'erreurs par type : not_found (404), validation (422), server_error (500)",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 26 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(inflation_api_errors_total[5m])",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["inflation-tracker", "C11", "prophet"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Europe/Paris",
  "title": "Inflation Tracker — API Modèle Prophet",
  "uid": "inflation-model",
  "version": 1
}
